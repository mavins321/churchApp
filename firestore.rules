rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Church Core Collections
    match /events/{document=**} {
      allow read, write: if true;
    }

    match /announcements/{document=**} {
      allow read, write: if true;
    }

    match /departments/{document=**} {
      allow read, write: if true;
    }

    match /groups/{document=**} {
      allow read, write: if true;
    }

    match /settings/{document=**} {
      allow read, write: if true;
    }

    match /checkInSessions/{document=**} {
      allow read, write: if true;
    }

    // 2. Attendance & QR Check-Ins
    match /attendance/{document=**} {
      allow read, write: if true;
    }

    // 3. User Profiles & Member Directory
    match /users/{document=**} {
      allow read, write: if true;
    }

    match /members/{document=**} {
      allow read, write: if true;
    }

    // 4. Pre-Registrations & Automated Reminders
    match /activity_registrations/{document=**} {
      allow read, write: if true;
    }

    match /notifications/{document=**} {
      allow read, write: if true;
    }

    match /notification_audit_logs/{document=**} {
      allow read, write: if true;
    }

    match /email_dispatches/{document=**} {
      allow read, write: if true;
    }

    // 5. Prayer Requests & Intercession Wall
    match /prayer_requests/{document=**} {
      allow read, write: if true;
    }

    // Default deny for unmanaged collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
